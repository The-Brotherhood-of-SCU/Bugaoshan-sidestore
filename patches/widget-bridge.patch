+func materializeKeychainSnapshot() -> String? {
+    guard let data = widgetKeychainRead(account: "db"), !data.isEmpty else {
+        print("BugaoShan Widget: no keychain snapshot")
+        return nil
+    }
+    let fileManager = FileManager.default
+    guard let dir = fileManager.urls(for: .cachesDirectory, in: .userDomainMask).first else {
+        widgetBridgeStatus = "no-cache-dir"
+        return nil
+    }
+    let url = dir.appendingPathComponent("bugaoshan-widget.db")
+    if let existing = try? Data(contentsOf: url), existing == data {
+        widgetBridgeStatus = "ok"
+        return url.path
+    }
+    do {
+        try data.write(to: url, options: .atomic)
+        widgetBridgeStatus = "ok"
+        return url.path
+    } catch {
+        print("BugaoShan Widget: failed to materialize snapshot: \(error)")
+        widgetBridgeStatus = "write-failed"
+        return nil
+    }
+}
